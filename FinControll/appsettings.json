{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {        
          "Microsoft": "Warning",
          "System": "Warning"
        }
      }
    },
  "WriteTo": [
    { "name": "Console" },
    {
      "Name": "File",
      "Args": {
        "path": "logs/api-log-.txt",
        "rollingInterval": "Day"
      }
    }
  ],
    "AllowedHosts": "*"
  }